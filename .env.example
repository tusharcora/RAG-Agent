# --- Postgres ---
POSTGRES_USER=backbone
POSTGRES_PASSWORD=backbone
POSTGRES_DB=backbone

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- LLM provider (Google AI Studio / Gemini) ---
GOOGLE_API_KEY=

# --- RAG agent: embeddings ---
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-lite
EMBEDDING_DIMENSIONS=512
QUERY_MODEL=gemini-3.6-flash
QUERY_TOP_K=5

# --- RAG agent: OAuth (project 2) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback
NOTION_API_VERSION=2022-06-28

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8000/oauth/jira/callback

# --- RAG agent: sync limits + abuse protection ---
MAX_PAGES_PER_SYNC=200
MAX_ISSUES_PER_SYNC=200
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_SYNC_PER_MINUTE=2
RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Auth ---
# Signs session JWTs. Empty is only accepted when ENVIRONMENT=local; the app
# fails to start with an empty secret otherwise. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
JWT_SECRET=

# --- Auth: social login (Google/GitHub sign-in for the app itself — NOT the
# Notion/Jira OAuth above, and NOT the code review bot's GitHub App below;
# these are separate OAuth apps you register at
# https://console.cloud.google.com/apis/credentials and
# https://github.com/settings/developers). Leave empty to disable a provider
# — its "Continue with ..." button 503s rather than crashing the app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# --- Code review bot: GitHub App (project 1) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
