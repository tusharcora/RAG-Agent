# Copy to .env.production on the server and fill in every blank.
# Never commit .env.production.

# --- Your public address (no https://, no trailing slash) ---
APP_DOMAIN=app.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=["https://app.example.com"]

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > token) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Datastores (pick long random passwords) ---
POSTGRES_USER=backbone
POSTGRES_PASSWORD=
POSTGRES_DB=backbone
RABBITMQ_USER=backbone
RABBITMQ_PASSWORD=

# --- Secrets: generate fresh ones for production, don't reuse local ones ---
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Models ---
GOOGLE_API_KEY=
QUERY_MODEL=gemini-3.6-flash
QUERY_TOP_K=5
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-lite
EMBEDDING_DIMENSIONS=512
VOYAGE_MAX_CONCURRENT_REQUESTS=3
VOYAGE_REQUESTS_PER_MINUTE=3
VOYAGE_FREE_TIER_TOKEN_BUDGET=200000000

# --- Notion / Jira data sources (callbacks go through the /api proxy) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://app.example.com/api/oauth/notion/callback
NOTION_API_VERSION=2022-06-28
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://app.example.com/api/oauth/jira/callback

# --- Optional sign-in with Google / GitHub (leave blank to hide) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://app.example.com/api/auth/github/callback

# --- Limits ---
MAX_PAGES_PER_SYNC=200
MAX_ISSUES_PER_SYNC=200
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=60
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_SYNC_PER_MINUTE=2
RATE_LIMIT_LOGIN_PER_MINUTE=10
LOG_LEVEL=INFO
